{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "prove.task_graph.v1"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "entry_stage": {
      "type": "string",
      "minLength": 1
    },
    "supervisor_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "enum": [
              "Move",
              "Approach",
              "Grasp",
              "Lift",
              "Align",
              "Insert",
              "Push",
              "Pull",
              "Rotate",
              "Release"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "object_part": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "goal_relation": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "eq",
                    "ne",
                    "lt",
                    "le",
                    "gt",
                    "ge"
                  ]
                },
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "signal",
                "op",
                "value"
              ]
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "eq",
                    "ne",
                    "lt",
                    "le",
                    "gt",
                    "ge"
                  ]
                },
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "signal",
                "op",
                "value"
              ]
            }
          },
          "termination": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "eq",
                    "ne",
                    "lt",
                    "le",
                    "gt",
                    "ge"
                  ]
                },
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "signal",
                "op",
                "value"
              ]
            }
          },
          "next_stage": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "start_step": {
                "type": "integer",
                "minimum": 0
              },
              "end_step": {
                "type": "integer",
                "minimum": 0
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "start_step",
              "end_step",
              "provenance"
            ]
          },
          "step_budget": {
            "type": "integer",
            "minimum": 1
          },
          "no_progress_budget": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "skill",
          "actor",
          "object",
          "object_part",
          "target",
          "goal_relation",
          "preconditions",
          "invariants",
          "termination",
          "next_stage",
          "evidence",
          "step_budget",
          "no_progress_budget"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "task_id",
    "entry_stage",
    "supervisor_inputs",
    "nodes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prove.task_graph.v1"
}
